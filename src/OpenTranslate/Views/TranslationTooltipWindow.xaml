<Window x:Class="OpenTranslate.Views.TranslationTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">
    <Border x:Name="RootBorder"
            Background="#313244"
            BorderBrush="#45475A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.5"
                              Color="Black" />
        </Border.Effect>
        <StackPanel>
            <StackPanel x:Name="PendingPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Grid x:Name="SpinnerHost"
                      Width="16"
                      Height="16"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Ellipse Width="16"
                             Height="16"
                             Stroke="#45475A"
                             StrokeThickness="2" />
                    <Ellipse Width="16"
                             Height="16"
                             Stroke="#89B4FA"
                             StrokeThickness="2"
                             StrokeDashArray="18.8 6.4"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="PendingText"
                           Text="Translating…"
                           Foreground="#CDD6F4"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBox x:Name="TranslationText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="#CDD6F4"
                     BorderThickness="0"
                     FontSize="13"
                     MaxHeight="240"
                     VerticalScrollBarVisibility="Auto" />

            <StackPanel x:Name="ActionPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                <Button x:Name="ReplaceButton"
                        Content="Replace"
                        Padding="8,3"
                        Background="#89B4FA"
                        Foreground="#1E1E2E"
                        BorderThickness="0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnReplace" />
                <Button x:Name="CopyButton"
                        Content="Copy"
                        Padding="8,3"
                        Margin="6,0,0,0"
                        Background="#45475A"
                        Foreground="#CDD6F4"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        Click="OnCopy" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
