<Window x:Class="OpenTranslate.Views.TranslationTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        MinWidth="220"
        MinHeight="100"
        MaxWidth="800"
        MaxHeight="700"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <!-- Slim, themed scrollbar matching the tooltip palette -->
        <Style x:Key="TooltipScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd"
                                Background="{DynamicResource ThemeSurfaceMuted}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource ThemeSurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TooltipScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TooltipScrollThumb}"
                                           Margin="1,0" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action buttons (Replace / Copy). The default button gets a bright accent
             ring so the user can see which one Enter will trigger. The border is always
             present but transparent, so toggling the default never reflows the layout. -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeDefaultButtonRing}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeOptionButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="FontWeight" Value="Normal" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="{DynamicResource ThemeSurface}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Opacity="0"
            RenderTransformOrigin="0,0"
            PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"
                                ScaleX="0.35"
                                ScaleY="0.35" />
                <TranslateTransform x:Name="RootTranslate"
                                    X="0"
                                    Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.5"
                              Color="Black" />
        </Border.Effect>
        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TextRow" Height="*" MinHeight="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="PendingPanel"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Grid x:Name="SpinnerHost"
                      Width="20"
                      Height="20"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <TextBlock x:Name="SpinnerGlyph"
                               Text="あ"
                               FontSize="16"
                               FontFamily="Consolas, Segoe UI"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThemeSpinner}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="SpinnerGlow"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="PendingText"
                           Text="Translating…"
                           Foreground="{DynamicResource ThemeForeground}"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBox x:Name="TranslationText"
                     Grid.Row="1"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="{DynamicResource ThemeForeground}"
                     BorderThickness="0"
                     FontSize="13"
                     VerticalAlignment="Stretch"
                     VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TooltipScrollBar}" />
                </TextBox.Resources>
            </TextBox>

            <Grid x:Name="ActionPanel"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Button x:Name="ModesButton"
                        Content="Modes ▾"
                        HorizontalAlignment="Left"
                        Padding="8,3"
                        Background="{DynamicResource ThemeSurfaceHover}"
                        Foreground="{DynamicResource ThemeForeground}"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnToggleModes" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="ReplaceButton"
                            Content="Replace"
                            Style="{StaticResource ActionButton}"
                            Padding="8,3"
                            Background="{DynamicResource ThemeAccent}"
                            Foreground="{DynamicResource ThemeAccentForeground}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnReplace" />
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Style="{StaticResource ActionButton}"
                            Padding="8,3"
                            Margin="6,0,0,0"
                            Background="{DynamicResource ThemeSurfaceHover}"
                            Foreground="{DynamicResource ThemeForeground}"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnCopy" />
                </StackPanel>
            </Grid>

            <Border x:Name="ModesPanelBorder"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Background="{DynamicResource ThemeModesPanel}"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Visibility="Collapsed">
                <StackPanel x:Name="ModesPanel" />
            </Border>

            <TextBlock x:Name="ResizeGripHint"
                       Grid.Row="1"
                       Grid.RowSpan="3"
                       Text="⤡"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       Foreground="{DynamicResource ThemeSurfaceMuted}"
                       FontSize="11"
                       Opacity="0.65"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
