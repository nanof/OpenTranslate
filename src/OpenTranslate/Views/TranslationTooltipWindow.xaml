<Window x:Class="OpenTranslate.Views.TranslationTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420"
        KeyDown="OnKeyDown"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <!-- Slim, themed scrollbar matching the tooltip palette -->
        <Style x:Key="TooltipScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd"
                                Background="#585B70"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#6C7086" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#89B4FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TooltipScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource TooltipScrollThumb}"
                                           Margin="1,0" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeOptionButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="FontWeight" Value="Normal" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#45475A" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="RootBorder"
            Background="#313244"
            BorderBrush="#45475A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            MaxWidth="420"
            Opacity="0"
            RenderTransformOrigin="0,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"
                                ScaleX="0.35"
                                ScaleY="0.35" />
                <TranslateTransform x:Name="RootTranslate"
                                    X="0"
                                    Y="10" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="2"
                              Opacity="0.5"
                              Color="Black" />
        </Border.Effect>
        <StackPanel>
            <StackPanel x:Name="PendingPanel"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <Grid x:Name="SpinnerHost"
                      Width="20"
                      Height="20"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <TextBlock x:Name="SpinnerGlyph"
                               Text="あ"
                               FontSize="16"
                               FontFamily="Consolas, Segoe UI"
                               FontWeight="Bold"
                               Foreground="#00FF41"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FF41"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.9" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="PendingText"
                           Text="Translating…"
                           Foreground="#CDD6F4"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBox x:Name="TranslationText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="#CDD6F4"
                     BorderThickness="0"
                     FontSize="13"
                     MaxHeight="240"
                     VerticalScrollBarVisibility="Auto">
                <TextBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TooltipScrollBar}" />
                </TextBox.Resources>
            </TextBox>

            <Grid x:Name="ActionPanel"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Button x:Name="ModesButton"
                        Content="Modes ▾"
                        HorizontalAlignment="Left"
                        Padding="8,3"
                        Background="#45475A"
                        Foreground="#CDD6F4"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnToggleModes" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="ReplaceButton"
                            Content="Replace"
                            Padding="8,3"
                            Background="#89B4FA"
                            Foreground="#1E1E2E"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="OnReplace" />
                    <Button x:Name="CopyButton"
                            Content="Copy"
                            Padding="8,3"
                            Margin="6,0,0,0"
                            Background="#45475A"
                            Foreground="#CDD6F4"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnCopy" />
                </StackPanel>
            </Grid>

            <Border x:Name="ModesPanelBorder"
                    Margin="0,8,0,0"
                    Background="#272736"
                    BorderBrush="#45475A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Visibility="Collapsed">
                <StackPanel x:Name="ModesPanel" />
            </Border>
        </StackPanel>
    </Border>
</Window>
