<Window x:Class="OpenTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OpenTranslate.Converters"
        Title="OpenTranslate — Settings"
        Width="460"
        Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBg}"
        FontSize="15">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource ThemeForeground}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource ThemeSurface}"
                                        BorderBrush="{DynamicResource ThemeBorder}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkEditableComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceHover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"
                                         Focusable="True"
                                         IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                         Visibility="Hidden" />
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <ToggleButton x:Name="ToggleButton"
                                              Grid.Column="1"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource ThemeForeground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </ToggleButton>
                            </Grid>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource ThemeSurface}"
                                        BorderBrush="{DynamicResource ThemeBorder}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForeground}" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverAlt}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedAlt}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundMuted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="12,7"
                                Margin="0,0,4,0"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource ThemeSurface}"
                                    BorderThickness="0,0,0,1"
                                    Margin="0,0,0,12">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,6" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource DarkTabControl}">
            <TabItem Header="Provider">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Provider"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding SelectedProvider, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding ApiKeyLabel}"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15"
                                   Visibility="{Binding RequiresApiKey, Converter={StaticResource BoolToVis}}" />
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Padding="6,4"
                                 Background="{DynamicResource ThemeSurface}"
                                 Foreground="{DynamicResource ThemeForeground}"
                                 BorderBrush="{DynamicResource ThemeBorder}"
                                 Visibility="{Binding RequiresApiKey, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding SupportsModelSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Model"
                                       Foreground="{DynamicResource ThemeForegroundMuted}"
                                       Margin="0,0,0,4"
                                       FontSize="15" />
                            <Grid Margin="0,0,0,6">
                                <TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4"
                                         Background="{DynamicResource ThemeSurface}"
                                         Foreground="{DynamicResource ThemeForeground}"
                                         BorderBrush="{DynamicResource ThemeBorder}"
                                         FontSize="15" />
                                <TextBlock Text="Filter models…"
                                           Foreground="{DynamicResource ThemeForegroundDim}"
                                           FontSize="15"
                                           Margin="10,5,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModelFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding FilteredModels}"
                                      SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsModelsLoading, Converter={StaticResource InverseBool}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}"
                                                       Foreground="{DynamicResource ThemeForeground}"
                                                       FontSize="15" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource ThemeForegroundMuted}"
                                                       FontSize="13"
                                                       Margin="0,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding ModelPerformanceHint}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="2,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeSuccess}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModelPerformanceHint}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ModelPerformanceIsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Improve text (AI)"
                                       Foreground="{DynamicResource ThemeForegroundMuted}"
                                       Margin="0,12,0,4"
                                       FontSize="15" />
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      ItemsSource="{Binding AvailableImprovements}"
                                      SelectedItem="{Binding SelectedImprovement, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Languages">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Source language"
                                           Foreground="{DynamicResource ThemeForegroundMuted}"
                                           Margin="0,0,0,4"
                                           FontSize="15" />
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValue="{Binding SourceLanguage, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Target language"
                                           Foreground="{DynamicResource ThemeForegroundMuted}"
                                           Margin="0,0,0,4"
                                           FontSize="15" />
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedValue="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{Binding AutoDetectLanguageLabel}"
                                  IsChecked="{Binding AutoDetectLanguage}"
                                  IsEnabled="{Binding SupportsAutoDetect}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Preserve code, URLs, paths, and mentions"
                                  IsChecked="{Binding PreserveFormatAndCode}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Appearance"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Start with Windows"
                                  IsChecked="{Binding StartWithWindows}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Play sound when translation starts"
                                  IsChecked="{Binding PlaySoundOnTranslationStart}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Type the translation character by character (typewriter)"
                                  IsChecked="{Binding TypewriterPaste}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="Tooltip font size"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15" />
                        <TextBox Text="{Binding TooltipFontSize, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Padding="6,4"
                                 Background="{DynamicResource ThemeSurface}"
                                 Foreground="{DynamicResource ThemeForeground}"
                                 BorderBrush="{DynamicResource ThemeBorder}" />

                        <TextBlock Text="Tooltip position"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding AvailableTooltipPlacements}"
                                  SelectedItem="{Binding SelectedTooltipPlacement, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="Keyboard shortcut"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,0,0,4"
                                   FontSize="15" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ShortcutDisplay, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Padding="6,4"
                                     Background="{DynamicResource ThemeSurface}"
                                     Foreground="{DynamicResource ThemeForeground}"
                                     BorderBrush="{DynamicResource ThemeBorder}" />
                            <Button Grid.Column="1"
                                    Content="Change…"
                                    Click="OnChangeShortcut"
                                    Style="{StaticResource SettingsSecondaryButton}"
                                    Margin="6,0,0,0"
                                    Padding="10,4" />
                        </Grid>

                        <CheckBox Content="Press twice in a row"
                                  IsChecked="{Binding ShortcutDoublePress}"
                                  Foreground="{DynamicResource ThemeForeground}"
                                  FontSize="15"
                                  Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Usage">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Usage (local estimate)"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   Margin="0,4,0,4"
                                   FontSize="15" />
                        <TextBlock Text="{Binding UsageSummary}"
                                   Foreground="{DynamicResource ThemeForegroundSubtle}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Tokens are approximated (chars ÷ 4). Stored only on this device."
                                   Foreground="{DynamicResource ThemeForegroundDim}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Button Content="Reset usage statistics"
                                Command="{Binding ResetUsageCommand}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SettingsSecondaryButton}"
                                Padding="10,4"
                                Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="OpenTranslate"
                                   Foreground="{DynamicResource ThemeForeground}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="{Binding AppVersion}"
                                   Foreground="{DynamicResource ThemeForegroundMuted}"
                                   FontSize="14"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding UpdateStatus}"
                                   Foreground="{DynamicResource ThemeForegroundSubtle}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Check for updates"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource SettingsSecondaryButton}"
                                    Padding="10,4"
                                    Margin="0,0,6,0" />
                            <Button Content="Download"
                                    Command="{Binding DownloadUpdateCommand}"
                                    Style="{StaticResource SettingsPrimaryButton}"
                                    Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="Windows clipboard translator powered by AI models via OpenRouter, OpenAI, or Gemini."
                                   Foreground="{DynamicResource ThemeForegroundSubtle}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock Margin="0,0,0,6">
                            <Hyperlink NavigateUri="{Binding ProjectUrl}"
                                       RequestNavigate="OnOpenLink"
                                       Foreground="{DynamicResource ThemeAccent}">
                                <Run Text="{Binding ProjectUrl, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Free for noncommercial use under the Polyform Noncommercial License."
                                   Foreground="{DynamicResource ThemeForegroundSubtle}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Margin="0,0,0,6">
                            <Hyperlink NavigateUri="{Binding LicenseUrl}"
                                       RequestNavigate="OnOpenLink"
                                       Foreground="{DynamicResource ThemeAccent}">
                                <Run Text="View license" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Commercial use requires a separate license."
                                   Foreground="{DynamicResource ThemeForegroundSubtle}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Margin="0,0,0,6">
                            <Hyperlink NavigateUri="{Binding CommercialLicenseUrl}"
                                       RequestNavigate="OnOpenLink"
                                       Foreground="{DynamicResource ThemeAccent}">
                                <Run Text="Request a commercial license" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,12">
                            <Hyperlink NavigateUri="{Binding BuyMeACoffeeUrl}"
                                       RequestNavigate="OnOpenLink"
                                       Foreground="{DynamicResource ThemeAccent}">
                                <Run Text="Buy Me a Coffee" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Copyright © Ignacio Martínez"
                                   Foreground="{DynamicResource ThemeForegroundDim}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ThemeAccent}"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Margin="0,10,0,10"
                   MinHeight="16" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Test"
                    Command="{Binding TestTranslationCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource SettingsSecondaryButton}"
                    Padding="12,5"
                    Margin="0,0,6,0" />
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Style="{StaticResource SettingsPrimaryButton}"
                    Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>
